  "info": {
    "title": "Pet Heaven Society API",
    "description": "REST API for Pet Heaven Society — pet listings, member registration, adoption applications, and pet surrender forms.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MemberLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "example": "password1"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed JWT access token"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "AdminLoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "admin"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RegisterMemberDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 128,
            "example": "Alice Tan"
          },
          "email": {
            "type": "string",
            "maxLength": 256,
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 256,
            "example": "password1"
          },
          "phone": {
            "type": "string",
            "maxLength": 32,
            "example": "+65 9123 0001"
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "PetType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PetType"
              }
            ]
          },
          "breed": {
            "type": "string",
            "nullable": true
          },
          "ageYears": {
            "type": "number",
            "nullable": true
          },
          "gender": {
            "enum": [
              "male",
              "female",
              "unknown"
            ],
            "type": "string"
          },
          "summaryDesc": {
            "type": "string",
            "nullable": true
          },
          "fullDesc": {
            "type": "string",
            "nullable": true
          },
          "photoRef": {
            "type": "string",
            "nullable": true,
            "description": "Stored as a JSON string: `{\"type\":\"api\"|\"external\"|\"site\",\"uri\":\"…\"}`.\nUse the `photo` getter/setter for typed access."
          },
          "isAvailable": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "breed",
          "ageYears",
          "gender",
          "summaryDesc",
          "fullDesc",
          "photoRef",
          "isAvailable",
          "createdAt",
          "tags"
        ]
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "pets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pet"
            }
          }
        },
        "required": [
          "id",
          "name",
          "pets"
        ]
      },
      "PhotoRefDto": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "api",
              "external",
              "site"
            ],
            "type": "string"
          },
          "uri": {
            "type": "string",
            "maxLength": 512,
            "description": "For \"api\": the upload image id. For \"external\": full URL. For \"site\": /public relative path."
          }
        },
        "required": [
          "type",
          "uri"
        ]
      },
      "CreatePetDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "example": "Max"
          },
          "typeId": {
            "type": "number",
            "description": "Pet type id"
          },
          "breed": {
            "type": "string",
            "maxLength": 128
          },
          "ageYears": {
            "type": "number",
            "minimum": 0,
            "maximum": 999,
            "example": 3
          },
          "gender": {
            "enum": [
              "male",
              "female",
              "unknown"
            ],
            "type": "string"
          },
