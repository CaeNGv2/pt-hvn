# Copy to `.env` (or `.env.local`) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of the Pet Heaven backend REST API.
VITE_API_BASE_URL=http://localhost:3000

# base domain path of the hosted dist. if not "/", assumes GHA pages and enables hashrouting mode
VITE_PAGES_BASE_PATH=/pt-hvn/site
